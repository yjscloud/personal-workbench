# 服务端口与监听地址
# HOST 默认 127.0.0.1：对外由 nginx 443 反代，8787 不直接暴露。
# 只有容器里需要把端口映射出去时才改成 0.0.0.0，并且映射到宿主回环：
#   docker run -p 127.0.0.1:8787:8787 -e HOST=0.0.0.0 ...
PORT=8787
# HOST=127.0.0.1

# ── MySQL（必填，所有数据都落在这个库里）──────────────────────────────
# 首次使用先执行一次：mysql -uroot -p < server/db/bootstrap.sql
# 它会建库 personal_workbench 与只监听本机的账号 workbench。
# DB_PASSWORD 必须是随机强口令：openssl rand -hex 24。库里不再有默认口令，
# 留空会直接连不上 —— 这比"默认 workbench / workbench"安全，后者意味着
# 任何扫到 3306 的人都能直接进来。
# 另外两项不在代码里，但一样重要：3306 只绑 127.0.0.1（见 README）、
# 账号只授业务库的增删改查，不授 DROP。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=workbench
DB_PASSWORD=
DB_NAME=personal_workbench
# 连接池大小与连接超时（毫秒），单机部署保持默认即可
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10000

# ── Proxmox VE 连接（留空则进入演示模式，使用模拟数据）────────────────
# 生产环境请在 PVE 上创建「仅审计」权限的 API Token（保留权限分离，别用 root）：
#   pveum user token add workbench@pve monitor --privsep 1
# 页面上的关机 / 快照这类写操作建议改用短时 ticket，或在 PVE 侧单独授权，
# 不要把 Administrator 级别的 Token 交给这个面板。
PVE_HOST=pve.home.local
PVE_PORT=8006
PVE_TOKEN_ID=root@pam!workbench
PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 自签名证书时设为 false（等于关掉校验，只建议临时用）。
# 更好的做法是把 PVE 的私有 CA 交给应用：从 PVE 宿主机拷
#   /etc/pve/pve-root-ca.pem  →  server/data/pve-ca.pem
# 之后保持 PVE_VERIFY_TLS=true，链验通、主机名照验。
# 文件放别处时用 PVE_CA_FILE 指定路径。
PVE_VERIFY_TLS=true
# PVE_CA_FILE=/path/to/pve-root-ca.pem
# 默认节点，留空则取 /nodes 返回的第一个节点
PVE_NODE=pve

# ── Home Assistant（可选，留空则整机功耗回退到 CPU 估算模型）──────────
# 用途：接入米家智能插座的真实读数——整机功耗用实测当前功率，
#       电费按插座统计的近一月用电折算。
# 令牌获取：HA → 左下角头像 → 安全 → 长期访问令牌
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
# 插座（功率实体）现在在设置页的「插座列表」里管理，可加多个，无需在此配置。
# 下面两个只作为旧版单插座配置的兜底：设置里的插座列表为空时才会被读。
# 实体名里若带设备序列号（形如 cuco_cn_<序列号>_...），换掉再提交——那是设备标识
HA_POWER_ENTITY=sensor.plug_electric_power
HA_COUNTER_ENTITY=sensor.plug_power_consumption

# ── 运行模式 ↔ CPU 调频（可选）────────────────────────────────────────
# 标准模式 / 节能模式会分别把 PVE 母机的 CPU governor 切到下面两档。
# PVE 没有任何改 governor 的 API，只能在宿主上执行命令，所以走 SSH，
# 需要工作台到母机的免密登录：
#   ssh-keygen -t rsa -N '' -f /root/.ssh/id_rsa
#   ssh-copy-id root@<PVE 地址>
# 配好后在「监控数据 → 运行模式」里会显示母机的实际档位用于核对。
PVE_CPU_GOVERNOR_STANDARD=performance
PVE_CPU_GOVERNOR_ECO=powersave
PVE_SSH_USER=root
PVE_SSH_KEY=/root/.ssh/id_rsa

# ── 节能模式额外联动（可选）──────────────────────────────────────────
# 开启/关闭节能模式时调用的 webhook，会收到 {"enabled": true|false}
ECO_WEBHOOK_URL=
# 注意：这条命令在**工作台本机**执行，不是 PVE 上。
# 想改母机的 governor 请用上面的 PVE_CPU_GOVERNOR_*，不要写在这里。
# PVE_ECO_COMMAND=

# ── Hermes Agent Office（可选）──────────────────────────────────────
# 局域网里的「智能工位」网关：工位 / 员工在线状态走公开接口，不需要口令。
HERMES_BASE_URL=http://hermes.home.local
# 只有要调「登录后」的业务接口才需要下面两项；留空则只用公开的工位状态。
# ⚠️ 口令连续错误会被 Hermes 锁定（错误信息里会提示剩余尝试次数），
#    填之前先用浏览器登录一次确认是对的——服务端失败后也会自我冷却 5 分钟。
HERMES_USER=agent
HERMES_PASSWORD=
# Hermes 走 https 且是自签证书时设为 true
HERMES_VERIFY_TLS=false

# ── AI 助手（可选）──────────────────────────────────────────────────
# 不配置时助手使用内置的规则引擎（可离线回答监控/待办/工单/知识库问题）
# 任何 OpenAI 兼容端点都能填：官方 API、本地 Ollama / vLLM，
# 或者局域网里的 Hermes Agent —— 它的 API Server 默认在 :8642，
# 走标准 OpenAI 协议（密钥取 Hermes 机器上 ~/.hermes/.env 的 API_SERVER_KEY）：
#   AI_BASE_URL=http://<hermes-ip>:8642/v1
#   AI_MODEL=hermes-agent
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 单次问答的等待上限（毫秒，默认 120000，下限 5000）。
# Hermes 这类 agent 处理复杂问题要做多步推理，实测要 29 秒。
# ⚠️ 若经 nginx 反代访问，proxy_read_timeout 必须大于这个值，
#    否则连接会先被反代掐断，前端收到 504 而不是工作台的提示。
AI_TIMEOUT_MS=120000
# 流式问答的整体等待上限（毫秒，默认 300000）。
# 另有固定的 90 秒空闲上限：流里连续 90 秒没有任何分片就断开，
# 用来兜住「模型陷在长循环里、什么都不吐」的情况。
AI_STREAM_TIMEOUT_MS=300000

# ── DeepSeek 余额（可选，右下角桌宠用）────────────────────────────────
# 鲸娘头顶那颗余额标读的就是它：走官方的 GET /user/balance 取回总余额 /
# 赠金 / 充值余额，并**按天记一笔快照** —— 于是除了"现在还剩多少"，还答得
# 出"今天花了多少"和最近两周的趋势（余额是存量，消耗才是要盯的那个数）。
#
# 留空：不显示余额，只显示一行「未配 Key」；摸头、签到、闲聊照常。
# Key 只在服务端读，浏览器侧永远拿不到它，也没有任何遥测。
DEEPSEEK_API_KEY=
# 想走自建 / 代理入口时改它。结尾带 /v1 也认（会被削掉 —— 余额接口挂在
# 根路径上，不跟着 OpenAI 兼容的前缀走）。
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── GitHub star 卡片（监控页）────────────────────────────────────────
# 盯哪个仓库、发到哪个飞书群，都在「设置 → GitHub Star 监控」里改（存数据库），
# 这里只是兜底：界面里没填时才读这两项 —— 老部署、或者想用环境变量统一管时用。
# 服务每 12 小时采一次，涨幅 > 0 时发一条飞书；留空 = 只记数不发通知。
# 地址在飞书群「设置 → 群机器人 → 自定义机器人」里拿。
# 注意：界面里清空地址想停掉通知时，如果这里填了值，它会被继续使用 ——
# 要彻底关掉，就把这一行也留空并重启。
FEISHU_WEBHOOK_URL=
# 机器人若开了「签名校验」才需要填。不填时发的是不带签名的文本，
# 开了签名的机器人会回 19021，那时把 secret 填上即可（算法见
# services/github-stars.js，key = "时间戳\nsecret" 的 HMAC-SHA256）。
# FEISHU_WEBHOOK_SECRET=
# 可选。配了之后，外部任务提交的飞书卡片里会多一个「在面板中查看」按钮。
# PANEL_URL=https://workbench.example.com
# 可选。GitHub 未认证只有 60 次/小时（按出口 IP 算），一天两次采集用不到；
# 但如果你和别的程序共用出口 IP，填一个只读 token 能把额度提到 5000 次/小时。
# GITHUB_TOKEN=

# ── 邮件通知（外链任务完成时回信）──────────────────────────────────
# 一般不用改这里：设置 → 邮件通知 里填的优先，.env 只当兜底。
# QQ / 163 的 pass 是"授权码"，不是登录密码。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@qq.com
# SMTP_PASS=
# SMTP_FROM=you@qq.com

# ── 设置里那些凭据的加密密钥 ─────────────────────────────────────────
# PVE Token、COS 密钥对、SMTP 授权码、飞书 webhook、面板口令哈希在库里
# 都是 AES-256-GCM 密文（见 services/secrets.js），密钥不落库。
# 不填时自动生成到 server/data/.settings-key（0600）。想真正做到"库泄露
# 拿不到凭据"，就把密钥放进密钥托管 / 启动注入，让数据库和它不同信任域：
#   openssl rand -hex 32   →  填到下面
# 注意：换了密钥，旧密文就解不开了（配置会变空，需要重填）。
# SETTINGS_KEY=

# ── 内部探活令牌（可选）──────────────────────────────────────────────
# /api/health 对外只回 {status, uptime}；本机回环或带上
#   X-Health-Token: <这里填的值>
# 才返回库名、表行数、各子系统是否配置等诊断信息。
# 远程监控需要详细诊断时才配，平时留空即可。
# HEALTH_TOKEN=

# ── 登录（面板账号）──────────────────────────────────────────────────
# 留空 AUTH_PASSWORD = 关闭登录（接口全部开放）。
# 会话密钥 AUTH_SECRET 不填会自动生成到 server/data/.auth-secret。
AUTH_USER=admin
AUTH_PASSWORD=
# AUTH_SECRET=
